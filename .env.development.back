# внутренний порт контейнера todo-back-container
PORT=3000

# DB_HOST - имя контейнера для БД, к нему будет обращаться бэк
DB_HOST=todo-db-container
DB_PORT=5432
DB_USER=todo
DB_PASSWORD=todo
DB_NAME=todo

# по этому url доступен фронт в браузере, 18080 - внешний порт, задан при запуске контейнера todo-front-container. именно с этого origin бэк разрешает делать запросы
CORS_ORIGIN=http://localhost:18080